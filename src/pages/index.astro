---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardPractice from '../components/CardPractice.astro';
import LegalHealthQuiz from '../components/LegalHealthQuiz.astro';
import CTABand from '../components/CTABand.astro';

const practicePreview = [
  {
    title: 'Hukum Korporasi & M&A',
    description: 'Pendirian perusahaan, restrukturisasi, kepatuhan regulasi, dan transaksi merger & akuisisi bernilai tinggi.',
    iconName: 'corporate' as const,
  },
  {
    title: 'HAKI & Teknologi',
    description: 'Perlindungan merek dagang, hak cipta digital, paten teknologi, dan audit privasi data korporasi.',
    iconName: 'ip' as const,
  },
  {
    title: 'Litigasi Komersial',
    description: 'Pertahanan hukum agresif untuk sengketa saham, kepailitan, pidana bisnis, dan arbitrase internasional.',
    iconName: 'litigation' as const,
  },
];
---

<MainLayout
  title="Integritas Tanpa Kompromi"
  description="Aurelius & Associates Law Office — firma hukum butik di Hogwarts. Spesialisasi perlindungan aset korporasi, HAKI, dan mitigasi krisis hukum dengan transparansi biaya."
>

  <section class="hero">
    <div class="container">
      <div class="hero__inner hero__inner--center">
        <span class="badge-gold">Firma Hukum Boutique · Hogwarts</span>
        <h1>
          Integritas Tanpa Kompromi.<br />
          <em>Perlindungan Mutlak.</em>
        </h1>
        <p class="lead">
          Firma hukum butik yang mendedikasikan keahlian hukum tingkat tertinggi untuk melindungi aset korporasi, hak kekayaan intelektual, dan kepentingan hukum Anda dengan <strong>transparansi biaya</strong> sejak hari pertama.
        </p>
        <div class="hero__actions">
          <a href="/kontak" class="btn btn-gold-solid btn--lg">Konsultasi Sekarang</a>
          <a href="https://wa.me/6285171605225?text=Halo%20Aurelius%20Law%20Office,%20saya%20memerlukan%20bantuan%20darurat%20hukum." class="btn btn-emergency btn--lg">Darurat 24/7</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <SectionHeader
        badge="Nilai Utama"
        title="Bagaimana Kami Melindungi Anda"
        description="Tiga pilar yang mendefinisikan standar advokasi dan perlindungan hukum kami."
        centered
      />

      <div class="grid-3">
        <div class="value-card">
          <div class="value-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0a7.5 7.5 0 1 1-7.5-7.5h15a7.5 7.5 0 1 1-7.5 7.5z" />
            </svg>
          </div>
          <h3>Transparansi Radikal</h3>
          <p>Struktur biaya konsultasi dan litigasi dijelaskan secara terbuka — tanpa biaya tersembunyi.</p>
        </div>

        <div class="value-card">
          <div class="value-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.599-3.75A11.952 11.952 0 0 0 12 2.714z" />
            </svg>
          </div>
          <h3>Keahlian Kasus Bernilai Tinggi</h3>
          <p>Spesialisasi perlindungan aset digital, HAKI, dan mitigasi risiko komersial sebelum eskalasi.</p>
        </div>

        <div class="value-card">
          <div class="value-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5 10.5 3.75 12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3>Respons Cepat 24/7</h3>
          <p>Tim siap mengamankan posisi hukum dan aset penting Anda saat krisis penegakan hukum terjadi.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding section-muted section-border-top">
    <div class="container">
      <SectionHeader
        badge="Area Praktik"
        title="Keahlian Hukum Kami"
        description="Fokus pada empat pilar hukum bernilai tinggi untuk perlindungan kekayaan dan bisnis Anda."
        centered
      />

      <div class="grid-3">
        {practicePreview.map(practice => (
          <CardPractice
            title={practice.title}
            description={practice.description}
            iconName={practice.iconName}
          />
        ))}
      </div>

      <div style="text-align: center; margin-top: var(--space-10);">
        <a href="/area-hukum" class="btn btn-gold-outline">Lihat Semua Area Hukum</a>
      </div>
    </div>
  </section>

  <section class="section-padding section-border-top">
    <div class="container container--narrow">
      <LegalHealthQuiz />
    </div>
  </section>

  <CTABand
    title="Butuh Pendampingan Hukum?"
    description="Jadwalkan konsultasi rahasia dengan tim advokat senior kami. Respons dalam waktu maksimal 2 jam kerja."
    primaryLabel="Hubungi Kami"
    primaryHref="/kontak"
    secondaryLabel="Kenali Tim Kami"
    secondaryHref="/tim-kami"
  />

</MainLayout>
