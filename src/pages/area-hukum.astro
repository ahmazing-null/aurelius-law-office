---
import MainLayout from '../layouts/MainLayout.astro';
import CardPractice from '../components/CardPractice.astro';
import FeeCalculator from '../components/FeeCalculator.astro';

const practices = [
  {
    title: 'Hukum Korporasi & M&A',
    description: 'Pendirian struktur bisnis patuh hukum, perancangan kontrak kerja sama internasional, penanganan restrukturisasi perusahaan, modal ventura, kepatuhan regulasi OJK/BKPM, hingga proses likuidasi bisnis terukur.',
    iconName: 'corporate' as const
  },
  {
    title: 'Hak Kekayaan Intelektual & Teknologi',
    description: 'Pendaftaran dan litigasi merek dagang mewah, hak cipta seni digital, paten invensi teknologi, audit privasi sengketa data pengguna, serta perlindungan trade secret korporasi di era siber.',
    iconName: 'ip' as const
  },
  {
    title: 'Litigasi Komersial & Pidana Bisnis',
    description: 'Pertahanan hukum agresif untuk direksi atas dugaan tindak pidana kerah putih (korupsi/pencucian uang), sengketa kepemilikan saham, kepailitan komersial, dan arbitrase bisnis internasional.',
    iconName: 'litigation' as const
  },
  {
    title: 'Perlindungan Aset & Hukum Keluarga',
    description: 'Manajemen suksesi bisnis keluarga antargenerasi, pembentukan struktur Trust Fund perlindungan aset dari klaim kreditur sengketa, dan perencanaan warisan korporat berskala premium.',
    iconName: 'asset' as const
  }
];
---

<MainLayout 
  title="Area Hukum" 
  description="Layanan hukum butik premium Aurelius & Associates. Meliputi Hukum Korporasi, HAKI & Teknologi, Litigasi Komersial, dan Perlindungan Aset Keluarga Premium."
>

  <!-- PRACTICE GRID SECTION -->
  <section class="section-padding" style="background-color: var(--color-bg-white);">
    <div class="container">
      
      <!-- Section Header -->
      <div style="text-align: center; margin-bottom: 4rem;">
        <span class="badge-gold">Keahlian Hukum Boutique</span>
        <h2 class="text-center" style="margin-top: 0.5rem; margin-bottom: 1rem; font-weight: 800;">Area Praktik Utama Kami</h2>
        <p style="font-size: 1rem; color: var(--color-text-secondary); max-width: 600px; margin: 0 auto;">
          Fokus pada 4 pilar hukum bernilai tinggi untuk memastikan perlindungan kekayaan, bisnis, dan aset digital Anda secara mutlak.
        </p>
      </div>

      <!-- Practice Cards Grid -->
      <div class="grid-2" style="gap: 2.5rem;">
        {practices.map(practice => (
          <CardPractice 
            title={practice.title}
            description={practice.description}
            iconName={practice.iconName}
          />
        ))}
      </div>

    </div>
  </section>

  <!-- FEE CALCULATOR TRANSISTION -->
  <section class="section-padding" style="background-color: var(--color-bg-alabaster); border-top: 1.5px solid var(--color-border-gold);">
    <div class="container" style="max-width: 1000px;">
      
      <!-- Fee Calculator component -->
      <FeeCalculator />

    </div>
  </section>

</MainLayout>
