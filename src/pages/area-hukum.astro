---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardPractice from '../components/CardPractice.astro';
import FeeCalculator from '../components/FeeCalculator.astro';

const practices = [
  {
    title: 'Hukum Korporasi & M&A',
    description: 'Pendirian struktur bisnis patuh hukum, perancangan kontrak kerja sama internasional, penanganan restrukturisasi perusahaan, modal ventura, kepatuhan regulasi OJK/BKPM, hingga proses likuidasi bisnis terukur.',
    iconName: 'corporate' as const,
  },
  {
    title: 'Hak Kekayaan Intelektual & Teknologi',
    description: 'Pendaftaran dan litigasi merek dagang, hak cipta seni digital, paten invensi teknologi, audit privasi sengketa data pengguna, serta perlindungan trade secret korporasi.',
    iconName: 'ip' as const,
  },
  {
    title: 'Litigasi Komersial & Pidana Bisnis',
    description: 'Pertahanan hukum untuk direksi atas dugaan tindak pidana kerah putih, sengketa kepemilikan saham, kepailitan komersial, dan arbitrase bisnis internasional.',
    iconName: 'litigation' as const,
  },
  {
    title: 'Perlindungan Aset & Hukum Keluarga',
    description: 'Manajemen suksesi bisnis keluarga antargenerasi, pembentukan struktur trust fund, dan perencanaan warisan korporat berskala premium.',
    iconName: 'asset' as const,
  },
];
---

<MainLayout
  title="Area Hukum"
  description="Layanan hukum premium Aurelius & Associates: Hukum Korporasi, HAKI & Teknologi, Litigasi Komersial, dan Perlindungan Aset."
>

  <section class="section-padding">
    <div class="container">
      <SectionHeader
        badge="Keahlian Hukum"
        title="Area Praktik Utama Kami"
        description="Fokus pada empat pilar hukum bernilai tinggi untuk memastikan perlindungan kekayaan, bisnis, dan aset digital Anda."
        centered
      />

      <div class="grid-2">
        {practices.map(practice => (
          <CardPractice
            title={practice.title}
            description={practice.description}
            iconName={practice.iconName}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding section-muted section-border-top">
    <div class="container container--medium">
      <FeeCalculator />
    </div>
  </section>

</MainLayout>
