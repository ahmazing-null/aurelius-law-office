---
import MainLayout from '../layouts/MainLayout.astro';
import CaseTimeline from '../components/CaseTimeline.astro';
---

<MainLayout 
  title="Tentang Kami" 
  description="Ketahui kisah berdirinya Aurelius & Associates Law Office dan bagaimana kami mendefinisikan ulang layanan hukum di era digital melalui transparansi dan ketajaman strategi."
>

  <!-- ABOUT NARRATIVE HERO -->
  <section style="background-color: var(--color-bg-alabaster); padding: 6rem 0; border-bottom: 0.5px solid var(--color-border-gold); position: relative;">
    <div class="container">
      <div class="grid-2" style="align-items: center; gap: 4rem;">
        
        <div>
          <span class="badge-gold">Corporate Narrative</span>
          <h2 style="margin-top: 0.5rem; margin-bottom: 1.5rem; font-weight: 800; color: var(--color-text-primary); line-height: 1.2;">
            Mendefinisikan Ulang<br />
            Layanan Hukum Era Digital.
          </h2>
          <p style="font-size: 1.1rem; line-height: 1.8; color: var(--color-text-primary); font-weight: 400; margin-bottom: 1.5rem;">
            Aurelius & Associates didirikan bukan sekadar untuk memenangkan persidangan, tetapi untuk mendefinisikan ulang bagaimana layanan hukum seharusnya diberikan di era digital.
          </p>
          <p style="font-size: 1rem; line-height: 1.7; color: var(--color-text-secondary); font-weight: 300;">
            Kami menghapus birokrasi hukum konvensional yang berbelit-belit, memberikan kepastian biaya secara transparan sejak hari pertama, serta menggerakkan pembelaan hukum dengan ketajaman strategi analitik berbasis mitigasi risiko krisis 24/7.
          </p>
        </div>

        <!-- Decorative Abstract Gavel SVG/Graphic -->
        <div style="background-color: var(--color-bg-white); border: 0.5px solid var(--color-border-gold); padding: 3rem; border-radius: var(--radius-sm); box-shadow: var(--shadow-md); display: flex; flex-direction: column; gap: 1.5rem;">
          <h3 style="color: var(--color-gold-dark); border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem; font-weight: 700;">Statistik Kepatuhan Klien</h3>
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
            <div>
              <span style="font-size: 2rem; font-weight: 800; color: var(--color-text-primary); display: block;">100%</span>
              <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-light); font-weight: 600;">Transparansi Biaya</span>
            </div>
            <div>
              <span style="font-size: 2rem; font-weight: 800; color: var(--color-text-primary); display: block;">98.4%</span>
              <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-light); font-weight: 600;">Penyelesaian Non-Litigasi</span>
            </div>
            <div>
              <span style="font-size: 2rem; font-weight: 800; color: var(--color-text-primary); display: block;">24/7</span>
              <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-light); font-weight: 600;">Kesiapan Respons Krisis</span>
            </div>
            <div>
              <span style="font-size: 2rem; font-weight: 800; color: var(--color-text-primary); display: block;">Rp 50B+</span>
              <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-light); font-weight: 600;">Aset Korporasi Terlindungi</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CASE TIMELINE ROADMAP -->
  <section class="section-padding" style="background-color: var(--color-bg-white);">
    <div class="container">
      
      <!-- Section Header -->
      <div style="text-align: center; margin-bottom: 4rem;">
        <span class="badge-gold">Alur Layanan</span>
        <h2 class="text-center" style="margin-top: 0.5rem; margin-bottom: 1rem; font-weight: 800;">4 Fase Perjalanan Hukum Anda</h2>
        <p style="font-size: 1rem; color: var(--color-text-secondary); max-width: 600px; margin: 0 auto;">
          Inovasi visual pemetaan proses mitigasi perkara dari tinjauan analitis risiko awal hingga pengamanan aset permanen.
        </p>
      </div>

      <!-- Case Timeline component -->
      <CaseTimeline />

    </div>
  </section>

</MainLayout>
