---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CaseTimeline from '../components/CaseTimeline.astro';

const stats = [
  { value: '100%', label: 'Transparansi Biaya' },
  { value: '98.4%', label: 'Penyelesaian Non-Litigasi' },
  { value: '24/7', label: 'Kesiapan Respons Krisis' },
  { value: 'Rp 50B+', label: 'Aset Korporasi Terlindungi' },
];
---

<MainLayout
  title="Tentang Kami"
  description="Kisah Aurelius & Associates Law Office — firma hukum butik di Jakarta dengan transparansi biaya dan ketajaman strategi hukum."
>

  <section class="page-hero page-hero--split">
    <div class="container">
      <div class="page-hero__grid">
        <div>
          <span class="badge-gold">Tentang Firma</span>
          <h1 class="section-heading">Mendefinisikan Ulang Layanan Hukum Modern</h1>
          <p class="lead">
            Aurelius & Associates didirikan bukan sekadar untuk memenangkan persidangan, melainkan untuk mendefinisikan ulang bagaimana layanan hukum seharusnya diberikan di era digital.
          </p>
          <p>
            Kami menghapus birokrasi hukum konvensional, memberikan kepastian biaya secara transparan sejak hari pertama, serta menggerakkan pembelaan hukum dengan ketajaman strategi analitik.
          </p>
        </div>

        <aside class="stats-panel">
          <h2 class="stats-panel__title">Statistik Kepatuhan Klien</h2>
          <div class="stats-grid">
            {stats.map(stat => (
              <div class="stat-item">
                <span class="stat-item__value">{stat.value}</span>
                <span class="stat-item__label">{stat.label}</span>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <SectionHeader
        badge="Alur Layanan"
        title="4 Fase Perjalanan Hukum Anda"
        description="Pemetaan proses mitigasi perkara dari tinjauan risiko awal hingga pengamanan aset permanen."
        centered
      />
      <CaseTimeline />
    </div>
  </section>

</MainLayout>
