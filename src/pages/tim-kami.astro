---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardAttorney from '../components/CardAttorney.astro';

const attorneys = [
  {
    name: 'Adrian Aurelius, S.H., LL.M.',
    role: 'Managing Partner',
    specialization: 'International Corporate Strategy, Mergers & Acquisitions, & White-Collar Defense.',
    alumnus: 'Universitas Indonesia (S.H.) & Harvard Law School (LL.M.)',
    avatarSeed: 'adrian',
  },
  {
    name: 'Dian Sastro Wardoyo, S.H., M.H.',
    role: 'Senior Partner',
    specialization: 'Intellectual Property Rights, Cyber Law, Luxury Brands IP Protection, & Digital Privacy.',
    alumnus: 'Universitas Gadjah Mada (S.H., M.H.)',
    avatarSeed: 'dian',
  },
  {
    name: 'Bintang Ramadhan, S.H.',
    role: 'Senior Associate',
    specialization: 'Commercial Litigation, High-Stakes Dispute Resolution, Corporate Bankruptcy, & Regulatory Compliance.',
    alumnus: 'Institut Teknologi Bandung — Hukum Bisnis & Kepatuhan Korporat (S.H.)',
    avatarSeed: 'bintang',
  },
    {
    name: 'Adrian Aurelius, S.H., LL.M.',
    role: 'Managing Partner',
    specialization: 'International Corporate Strategy, Mergers & Acquisitions, & White-Collar Defense.',
    alumnus: 'Universitas Indonesia (S.H.) & Harvard Law School (LL.M.)',
    avatarSeed: 'adrian',
  },
  {
    name: 'Dian Sastro Wardoyo, S.H., M.H.',
    role: 'Senior Partner',
    specialization: 'Intellectual Property Rights, Cyber Law, Luxury Brands IP Protection, & Digital Privacy.',
    alumnus: 'Universitas Gadjah Mada (S.H., M.H.)',
    avatarSeed: 'dian',
  },
  {
    name: 'Bintang Ramadhan, S.H.',
    role: 'Senior Associate',
    specialization: 'Commercial Litigation, High-Stakes Dispute Resolution, Corporate Bankruptcy, & Regulatory Compliance.',
    alumnus: 'Institut Teknologi Bandung — Hukum Bisnis & Kepatuhan Korporat (S.H.)',
    avatarSeed: 'bintang',
  },
];
---

<MainLayout
  title="Tim Advokat"
  description="Tim advokat Aurelius & Associates — kemitraan strategis dengan lulusan universitas terkemuka untuk melindungi hak hukum Anda."
>

  <section class="section-padding">
    <div class="container">
      <div class="team-header">
        <SectionHeader
          badge="Dewan Advokat"
          title="Kemitraan Advokat Elit"
          description="Tim ahli hukum terakreditasi internasional yang memadukan teori akademis elit dengan eksekusi pertahanan perkara yang strategis."
        />

        <div class="print-hint no-print">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.82l-.24-.047A4.9 4.9 0 0 1 3 9c0-2.761 2.239-5 5-5a4.9 4.9 0 0 1 4.78 3.82m0 0a4.897 4.897 0 0 1 4.04 1.832c.983.336 1.829.986 2.42 1.818M12 3v13.5m0 0-3-3m3 3 3-3M2 21h20" />
          </svg>
          <span>Tekan <strong>Ctrl + P</strong> untuk cetak profil resmi</span>
        </div>
      </div>

      <div class="grid-3">
        {attorneys.map(attorney => (
          <CardAttorney
            name={attorney.name}
            role={attorney.role}
            specialization={attorney.specialization}
            alumnus={attorney.alumnus}
            avatarSeed={attorney.avatarSeed}
          />
        ))}
      </div>

      <p class="team-footnote no-print">
        Seluruh advokat Aurelius & Associates terdaftar di PERADI dan tunduk sepenuhnya pada Kode Etik Advokat Indonesia.
      </p>
    </div>
  </section>

</MainLayout>

<style>
  .team-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-16);
  }

  .team-header :global(.section-header) {
    margin-bottom: 0;
  }

  .print-hint {
    border: 1px solid var(--color-border-gold);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--surface-muted);
    flex-shrink: 0;
  }

  .print-hint svg {
    width: 18px;
    height: 18px;
    color: var(--color-gold-dark);
  }

  .team-footnote {
    margin-top: var(--space-20);
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-style: italic;
  }
</style>
