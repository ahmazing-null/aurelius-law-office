---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardAttorney from '../components/CardAttorney.astro';

const attorneys = [
  {
    name: 'Luqi Ahmad Khilfa, LL.M., M.Law., Ph.D.',
    role: 'Managing Partner',
    specialization: 'Hukum Keluarga Internasional, Artificial Intelligence Law, Cyber Law, Digital Evidence, dan Legal Technology.',
    alumnus: '– S1 Hukum Keluarga – UIN Sunan Gunung Djati Bandung • LL.M. – National University of Singapore (Technology Law) • M.Law. – Leiden Law School (Comparative Family Law) • Ph.D. in Law – The University of Oxford (Artificial Intelligence & Justice)',
    avatarSeed: 'luqi',
  },
  {
    name: 'Muhammad Zulfi Askhiya, M.H.',
    role: 'Senior Partner',
    specialization: 'Hukum Perdata, Litigasi Perdata, dan Penyelesaian Sengketa.',
    alumnus: '– S1 Ilmu Hukum – Universitas Padjadjaran • M.H. – Universitas Padjadjaran',
    avatarSeed: 'zulfi',
  },
  {
    name: 'Dr. Nidia Gitania, S.H., M.H.',
    role: 'Senior Partner',
    specialization: 'Hukum Perdata, Hukum Islam, dan Hukum Keluarga.',
    alumnus: '– S1 Hukum Keluarga – Universitas Islam Indonesia • S2 Ilmu Hukum – Universitas Gadjah Mada • S3 Hukum Perdata – Universitas Gadjah Mada',
    avatarSeed: 'nidia',
  },
  {
    name: 'Prof. Dr. Rafi Aditya Syafiq, S.H., M.H.',
    role: 'Of Counsel',
    specialization: 'Hukum Perdata, Hukum Islam, dan Konsultasi Akademik.',
    alumnus: '– S1 Ilmu Hukum – Universitas Padjadjaran • S2 Ilmu Hukum – Universitas Gadjah Mada • S3 Hukum Perdata – Universitas Gadjah Mada',
    avatarSeed: 'rafi',
  },
  {
    name: 'Deden Julian, M.H.',
    role: 'Senior Associate',
    specialization: 'Hukum Perdata, Kontrak Bisnis, dan Kepatuhan Regulasi.',
    alumnus: '– Magister Hukum – Konsentrasi Hukum Perdata, Fakultas Hukum, Universitas Sultan Ageng Tirtayasa (UNTIRTA)',
    avatarSeed: 'deden',
  },
  {
    name: 'Dr. Seera Aozora, J.D., LL.M., S.J.D.',
    role: 'Partner',
    specialization: 'Hukum Kekayaan Intelektual, Paten Teknologi, Merek Dagang, dan Hak Cipta.',
    alumnus: '– J.D. Juris Doctor – Harvard Law School • LL.M. Master of Laws in Intellectual Property – Harvard Law School • S.J.D. Doctor of Juridical Science in Intellectual Property – Harvard Law School',
    avatarSeed: 'seera',
  },
  {
    name: 'Muhamad Rizky Nugraha, M.H.',
    role: 'Senior Associate',
    specialization: 'Hukum Tata Negara, Judicial Review, dan Constitutional Law.',
    alumnus: '– S1 Ilmu Hukum – Universitas Indonesia • M.H. Hukum Tata Negara – Universitas Indonesia',
    avatarSeed: 'rizky',
  },
  {
    name: 'Safta Aulia Putri Iklima, S.H., M.H., Ph.D.',
    role: 'Partner',
    specialization: 'Hukum Teknologi, Kekayaan Intelektual, dan Kebijakan Digital.',
    alumnus: '– S1 Ilmu Hukum – Universitas Padjadjaran (UNPAD) • LL.M. (Master of Laws) – National University of Singapore (NUS) • Ph.D. in Law – The University of Melbourne',
    avatarSeed: 'safta',
  },
];
---

<MainLayout
  title="Tim Advokat"
  description="Tim advokat Aurelius & Associates — kemitraan strategis dengan lulusan universitas terkemuka untuk melindungi hak hukum Anda."
>

  <section class="section-padding">
    <div class="container">
      <div class="team-header">
        <SectionHeader
          badge="Dewan Advokat"
          title="Kemitraan Advokat Elit"
          description="Tim ahli hukum terakreditasi internasional yang memadukan teori akademis elit dengan eksekusi pertahanan perkara yang strategis."
        />

        <div class="print-hint no-print">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.82l-.24-.047A4.9 4.9 0 0 1 3 9c0-2.761 2.239-5 5-5a4.9 4.9 0 0 1 4.78 3.82m0 0a4.897 4.897 0 0 1 4.04 1.832c.983.336 1.829.986 2.42 1.818M12 3v13.5m0 0-3-3m3 3 3-3M2 21h20" />
          </svg>
          <span>Tekan <strong>Ctrl + P</strong> untuk cetak profil resmi</span>
        </div>
      </div>

      <div class="grid-3">
        {attorneys.map(attorney => (
          <CardAttorney
            name={attorney.name}
            role={attorney.role}
            specialization={attorney.specialization}
            alumnus={attorney.alumnus}
            avatarSeed={attorney.avatarSeed}
          />
        ))}
      </div>

      <p class="team-footnote no-print">
        Seluruh advokat Aurelius & Associates terdaftar di PERADI dan tunduk sepenuhnya pada Kode Etik Advokat Indonesia.
      </p>
    </div>
  </section>

</MainLayout>

<style>
  .team-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-16);
  }

  .team-header :global(.section-header) {
    margin-bottom: 0;
  }

  .print-hint {
    border: 1px solid var(--color-border-gold);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--surface-muted);
    flex-shrink: 0;
  }

  .print-hint svg {
    width: 18px;
    height: 18px;
    color: var(--color-gold-dark);
  }

  .team-footnote {
    margin-top: var(--space-20);
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-style: italic;
  }
</style>