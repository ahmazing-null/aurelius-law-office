---
interface Props {
  name: string;
  role: string;
  specialization: string;
  alumnus: string;
  avatarSeed: string;
}

const { name, role, specialization, alumnus, avatarSeed } = Astro.props;
---

<article class="card-attorney surface-card">
  <div class="attorney-avatar-container">
    <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <radialGradient id={`bgGrad-${avatarSeed}`} cx="50%" cy="40%" r="60%">
          <stop offset="0%" stop-color="#FFFFFF" />
          <stop offset="100%" stop-color="#F1EFEA" />
        </radialGradient>
        <linearGradient id={`goldGrad-${avatarSeed}`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#C5A880" />
          <stop offset="100%" stop-color="#9A7F5C" />
        </linearGradient>
      </defs>
      <rect width="400" height="500" fill={`url(#bgGrad-${avatarSeed})`} />
      <path d="M50 450 L350 450" stroke="#E2D4C0" stroke-width="1" />
      <circle cx="200" cy="200" r="90" stroke="rgba(197, 168, 128, 0.25)" stroke-width="0.5" />
      <polygon points="200,100 240,150 200,200 160,150" stroke={`url(#goldGrad-${avatarSeed})`} stroke-width="1" fill="rgba(255, 255, 255, 0.7)" />
      <polygon points="200,200 300,320 270,450 130,450 100,320" stroke={`url(#goldGrad-${avatarSeed})`} stroke-width="1.5" fill="rgba(197, 168, 128, 0.05)" />
      <text x="200" y="475" fill="#9A7F5C" font-family="Plus Jakarta Sans" font-size="12" font-weight="600" letter-spacing="4" text-anchor="middle" opacity="0.7">AURELIUS</text>
    </svg>
    <span class="attorney-role-badge">{role}</span>
  </div>

  <div class="attorney-details">
    <h3>{name}</h3>

    <div class="attorney-meta">
      <div>
        <span class="attorney-meta__label">Spesialisasi</span>
        <p>{specialization}</p>
      </div>
      <div>
        <span class="attorney-meta__label">Pendidikan</span>
        <p class="attorney-meta__alumnus">{alumnus}</p>
      </div>
    </div>
  </div>
</article>

<style>
  .card-attorney {
    padding: var(--space-8);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: var(--transition-normal);
  }

  .card-attorney:hover {
    border-color: var(--color-border-gold);
    box-shadow: var(--shadow-md);
  }

  .attorney-avatar-container {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background-color: var(--color-bg-alabaster);
    border: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
    overflow: hidden;
  }

  .attorney-avatar-container svg {
    width: 100%;
    height: 100%;
  }

  .attorney-role-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background-color: var(--color-text-primary);
    color: var(--color-bg-white);
    font-size: 0.625rem;
    font-weight: 600;
    font-family: var(--font-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-sm);
  }

  .attorney-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .attorney-details h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-6);
  }

  .attorney-meta {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-4);
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .attorney-meta__label {
    font-size: 0.6875rem;
    font-weight: 600;
    font-family: var(--font-primary);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: var(--space-1);
  }

  .attorney-meta p {
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0;
  }

  .attorney-meta__alumnus {
    font-style: italic;
  }

  @media print {
    .card-attorney {
      border: 1px solid #c5a880 !important;
      box-shadow: none !important;
      page-break-inside: avoid;
    }
  }
</style>
