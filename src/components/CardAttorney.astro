---
interface Props {
  name: string;
  role: string;
  specialization: string;
  alumnus: string;
  avatarSeed: string;
}

const { name, role, specialization, alumnus, avatarSeed } = Astro.props;
const photoPath = `/images/team/${avatarSeed}.jpg`;
---

<article class="card-attorney surface-card">
  <div class="attorney-avatar-container">
    <object 
      data={photoPath} 
      type="image/jpeg" 
      width="300" 
      height="300" 
      aria-label={`Foto ${name}`}
      class="attorney-photo"
    >
      <svg viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <radialGradient id={`bgGrad-${avatarSeed}`} cx="50%" cy="40%" r="60%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="100%" stop-color="#F1EFEA" />
          </radialGradient>
          <linearGradient id={`goldGrad-${avatarSeed}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#C5A880" />
            <stop offset="100%" stop-color="#9A7F5C" />
          </linearGradient>
        </defs>
        <rect width="300" height="300" fill={`url(#bgGrad-${avatarSeed})`} />
        <circle cx="150" cy="130" r="70" stroke="rgba(197, 168, 128, 0.25)" stroke-width="0.5" />
        <polygon points="150,60 180,100 150,140 120,100" stroke={`url(#goldGrad-${avatarSeed})`} stroke-width="1" fill="rgba(255, 255, 255, 0.7)" />
        <polygon points="150,150 230,250 210,290 90,290 70,250" stroke={`url(#goldGrad-${avatarSeed})`} stroke-width="1.5" fill="rgba(197, 168, 128, 0.05)" />
        <text x="150" y="285" fill="#9A7F5C" font-family="Plus Jakarta Sans" font-size="10" font-weight="600" letter-spacing="3" text-anchor="middle" opacity="0.7">AURELIUS</text>
      </svg>
    </object>
    
    <span class="attorney-role-badge">{role}</span>
  </div>

  <div class="attorney-details">
    <h3 class="attorney-name">{name}</h3>

    <div class="attorney-meta">
      <div class="attorney-meta__item">
        <span class="attorney-meta__label">Spesialisasi</span>
        <p class="attorney-meta__text">{specialization}</p>
      </div>
      <div class="attorney-meta__item">
        <span class="attorney-meta__label">Pendidikan</span>
        <p class="attorney-meta__text attorney-meta__alumnus">{alumnus}</p>
      </div>
    </div>
  </div>
</article>

<style>
  .card-attorney {
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: var(--transition-normal);
    gap: var(--space-4);
  }

  .card-attorney:hover {
    border-color: var(--color-border-gold);
    box-shadow: var(--shadow-md);
  }

  .attorney-avatar-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 260px;
    background-color: var(--color-bg-alabaster);
    border: 1px solid var(--color-border-light);
    overflow: hidden;
    border-radius: var(--radius-xs);
    flex-shrink: 0;
  }

  .attorney-photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .attorney-avatar-container svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .attorney-role-badge {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    background-color: var(--color-text-primary);
    color: var(--color-bg-white);
    font-size: 0.6rem;
    font-weight: 600;
    font-family: var(--font-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 10px;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-xs);
    z-index: 2;
    white-space: nowrap;
  }

  .attorney-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-3);
  }

  .attorney-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin: 0;
  }

  .attorney-meta {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-3);
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .attorney-meta__item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .attorney-meta__label {
    font-size: 0.65rem;
    font-weight: 600;
    font-family: var(--font-primary);
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .attorney-meta__text {
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
    color: var(--color-text-secondary);
  }

  .attorney-meta__alumnus {
    font-style: italic;
    font-size: 0.75rem;
  }

  @media print {
    .card-attorney {
      border: 1px solid #c5a880 !important;
      box-shadow: none !important;
      page-break-inside: avoid;
    }
  }
</style>
