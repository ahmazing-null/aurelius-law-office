---
interface Props {
  title: string;
  description: string;
  iconName: 'corporate' | 'ip' | 'litigation' | 'asset';
}

const { title, description, iconName } = Astro.props;
---

<article class="practice-card frame-card">
  <div class="practice-card__icon">
    {iconName === 'corporate' && (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" />
      </svg>
    )}
    {iconName === 'ip' && (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    )}
    {iconName === 'litigation' && (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M9 6h6M8 10h8M6 14h12M4 18h16" />
      </svg>
    )}
    {iconName === 'asset' && (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75v5.25m3-5.25v5.25m3-5.25v5.25M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    )}
  </div>

  <h3 class="practice-card__title">{title}</h3>
  <p class="practice-card__description">{description}</p>
</article>

<style>
  .practice-card {
    padding: var(--space-10);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: var(--transition-normal);
    border: 2px solid var(--color-brown-dark);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-md);
  }

  .practice-card:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-lg);
    transform: translateY(-6px);
  }

  .practice-card__icon {
    color: var(--color-gold);
    margin-bottom: var(--space-6);
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-border-gold);
    background: rgba(200, 148, 62, 0.08);
    transition: var(--transition-normal);
  }

  .practice-card:hover .practice-card__icon {
    background: rgba(200, 148, 62, 0.15);
    border-color: var(--color-gold);
    color: var(--color-burgundy);
  }

  .practice-card__icon svg {
    width: 28px;
    height: 28px;
  }

  .practice-card__title {
    margin-bottom: var(--space-4);
    font-size: 1.25rem;
    color: var(--color-text-primary);
    transition: var(--transition-normal);
  }

  .practice-card:hover .practice-card__title {
    color: var(--color-burgundy);
  }

  .practice-card__description {
    font-size: 0.95rem;
    line-height: 1.7;
    flex-grow: 1;
    color: var(--color-text-secondary);
  }
</style>
